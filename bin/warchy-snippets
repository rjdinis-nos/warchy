#!/usr/bin/env bash
set -euo pipefail

# Configuration
COMMANDS_FILE="$XDG_CONFIG_HOME/warchy/commands"

# Catppuccin Mocha Colors
C_PINK="#f5c2e7"
C_MAUVE="#cba6f7"
C_TEXT="#cdd6f4"
C_SURFACE1="#45475a"
C_BLUE="#89b4fa"
C_YELLOW="#f9e2af"

# Check if commands file exists
if [[ ! -f "$COMMANDS_FILE" ]]; then
  echo "Error: Commands file not found at $COMMANDS_FILE" >&2
  echo "Create it with: mkdir -p $(dirname "$COMMANDS_FILE") && touch $COMMANDS_FILE" >&2
  exit 1
fi

# Truncate text to the given width (adding an ellipsis) and pad it to exactly
# that width, so columns line up in the flat list gum choose renders.
fit_cell() {
  local text="$1" width="$2"
  ((${#text} > width)) && text="${text:0:width-1}…"
  printf '%-*s' "$width" "$text"
}

# Column widths, derived from the terminal so long rows never wrap
terminal_cols=$(tput cols)
usable_cols=$((terminal_cols - 8))
cat_cols=$((usable_cols * 12 / 100))
desc_cols=$((usable_cols * 38 / 100))
cmd_cols=$((usable_cols - cat_cols - desc_cols - 4))
((cmd_cols < 10)) && cmd_cols=10

# Parse commands file into "<padded display row><US><command>" options.
# The unit separator is passed to gum as --label-delimiter: gum renders the
# label and returns the value verbatim, so commands containing commas or quotes
# need no escaping.
US=$'\x1f'
options=""
while IFS= read -r line || [[ -n "$line" ]]; do
  # Skip empty lines and single # comments
  [[ -z "$line" || "$line" =~ ^[[:space:]]*#[^#] ]] && continue

  # Split on # for category and description
  if [[ "$line" =~ ^([^#]+)#([^#]+)#(.+)$ ]]; then
    command="${BASH_REMATCH[1]}"
    category="${BASH_REMATCH[2]}"
    description="${BASH_REMATCH[3]}"
  elif [[ "$line" =~ ^([^#]+)##(.+)$ ]]; then
    command="${BASH_REMATCH[1]}"
    category=""
    description="${BASH_REMATCH[2]}"
  elif [[ "$line" =~ ^([^#]+)#(.+)$ ]]; then
    command="${BASH_REMATCH[1]}"
    category=""
    description="${BASH_REMATCH[2]}"
  else
    command="$line"
    category=""
    description=""
  fi

  # Trim whitespace
  command="${command#"${command%%[![:space:]]*}"}"
  command="${command%"${command##*[![:space:]]}"}"
  category="${category#"${category%%[![:space:]]*}"}"
  category="${category%"${category##*[![:space:]]}"}"
  description="${description#"${description%%[![:space:]]*}"}"
  description="${description%"${description##*[![:space:]]}"}"

  # Skip empty commands
  [[ -z "$command" ]] && continue

  # Build the padded display row and pair it with the raw command
  row="$(fit_cell "$category" "$cat_cols")  $(fit_cell "$command" "$cmd_cols")  $(fit_cell "$description" "$desc_cols")"
  options+="${row}${US}${command}"$'\n'
done <"$COMMANDS_FILE"

# Check if we have any commands
if [[ -z "$options" ]]; then
  echo "No commands found in file" >&2
  echo "Add commands to $COMMANDS_FILE in format: command # description" >&2
  exit 1
fi

# Calculate height as 90% of terminal rows
terminal_rows=$(tput lines)
list_height=$((terminal_rows * 90 / 100))
((list_height < 5)) && list_height=5

header="  $(fit_cell "Category" "$cat_cols")  $(fit_cell "Command" "$cmd_cols")  Description"

# Display list and capture the selected command
gum style --faint --padding "0 0 1 0" "Hint: edit commands in $COMMANDS_FILE"
selected=$(echo -n "$options" | gum choose \
  --label-delimiter "$US" \
  --header "$header" \
  --header.foreground "$C_MAUVE" \
  --cursor "❯ " \
  --cursor.foreground "$C_PINK" \
  --item.foreground "$C_TEXT" \
  --selected.foreground "$C_BLUE" \
  --selected.background "$C_SURFACE1" \
  --height "$list_height") || exit 0

# Exit if nothing selected
[[ -z "$selected" ]] && exit 0

# Show command being executed
echo -e "\033[2m\$ $selected\033[0m"

# Execute the command
eval "$selected"
