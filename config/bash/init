#!/bin/bash

# Source environment variables from package configurations (XDG-compliant)
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/bash/envs" ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/bash/envs"
fi

# Check for first-run post-install tasks (before shell tools load)
# This block is removed by first-run.sh after initial setup completes
if [[ -f "$XDG_STATE_HOME/warchy/first-run-pending" ]]; then
    source "$WARCHY_PATH/install/post-install/first-run.sh"
fi

if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"
fi

if command -v starship &> /dev/null; then
  eval "$(starship init bash)"
fi

if command -v zoxide &> /dev/null; then
  eval "$(zoxide init bash)"
fi

if command -v try &> /dev/null; then
  eval "$(try init ~/Work/tries)"
fi

if command -v uv &> /dev/null; then
  eval "$(uv generate-shell-completion bash)"
fi

if command -v fzf &> /dev/null; then
  if [[ -f /usr/share/fzf/completion.bash ]]; then
    source /usr/share/fzf/completion.bash
  fi
  if [[ -f /usr/share/fzf/key-bindings.bash ]]; then
    source /usr/share/fzf/key-bindings.bash
  fi
fi

if command -v gnome-keyring-daemon &> /dev/null; then
  if ! pgrep -u "$USER" -x gnome-keyring-d >/dev/null 2>&1; then
    # Start fresh daemon if none is running.  --daemonize forks to the
    # background and prevents env-var capture (GNOME_KEYRING_CONTROL
    # won't be set), but the daemon *does* come up.  D-Bus / Secret
    # Service discovery works fine without the env var, so apps like
    # pinentry-gnome3 and secret-tool still function.
    #
    # Avoid --unlock (requires interactive tty) and --start (fails
    # silently when a daemon isn't running yet).
    gnome-keyring-daemon --daemonize --components=secrets 2>/dev/null
  fi
fi

if command -v keychain &> /dev/null; then
  # Collect all private SSH keys from ~/.ssh/
  _kc_keys=()
  for _kc_key in ~/.ssh/id_*; do
    [[ -f "$_kc_key" ]] && [[ ! "$_kc_key" =~ \.pub$ ]] && _kc_keys+=("$_kc_key")
  done
  if [[ ${#_kc_keys[@]} -gt 0 ]]; then
    # Two unbounded prompts stand between login and a usable shell:
    #   1. keychain's "Press Enter to initialize keys" multi-terminal gate,
    #      which blocks in select() on /dev/tty forever. --immediate skips it
    #      and contends for the activation lock straight away.
    #   2. ssh-add's own passphrase prompt. warchy-ssh-askpass replaces it and
    #      times out (WARCHY_SSH_ASKPASS_TIMEOUT, default 20s), so an
    #      unattended login continues with the key unloaded instead of hanging.
    #      SSH_ASKPASS_REQUIRE=force is what makes ssh-add use an askpass at
    #      all when a tty is present.
    _kc_askpass="$WARCHY_PATH/bin/utils/warchy-ssh-askpass"
    if [[ -x "$_kc_askpass" ]]; then
      eval "$(SSH_ASKPASS="$_kc_askpass" SSH_ASKPASS_REQUIRE=force \
        keychain --dir "${KEYCHAIN_DIR:-$HOME/.ssh/.keychain}" --immediate --eval --quiet "${_kc_keys[@]}")"
    else
      # Helper missing — fall back to the interactive terminal prompt
      unset SSH_ASKPASS_REQUIRE
      eval "$(keychain --dir "${KEYCHAIN_DIR:-$HOME/.ssh/.keychain}" --eval --quiet "${_kc_keys[@]}")"
    fi
    export SSH_ASKPASS_REQUIRE=prefer
  fi
  unset _kc_keys _kc_key _kc_askpass
fi
